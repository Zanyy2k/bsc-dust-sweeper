# Bot wallet private key (never commit the real .env)
BOT_PRIVATE_KEY=0xyour_private_key_here

# BSC RPC
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Deployed contract address
CONTRACT_ADDRESS=0x

# Fee recipient (your wallet address)
FEE_RECIPIENT=0xyour_wallet_address_here

# Fee percentage (e.g. 15 = 15%)
FEE_BPS=15
